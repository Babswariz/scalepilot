# ScalePilot Environment Variables
# Copy this file to .env.local and fill in your values

# Database Configuration
# For local development, SQLite is recommended
DATABASE_URL="file:./prisma/dev.db"

# For production, use PostgreSQL or MySQL
# DATABASE_URL="postgresql://user:password@localhost:5432/scalepilot"

# Admin Authentication
# Change this to a strong password in production
ADMIN_PASSWORD="admin123"

# Flutterwave Payments
FLUTTERWAVE_PUBLIC_KEY="FLWPUBK-..."
FLUTTERWAVE_SECRET_KEY="FLWSECK-..."

# Email Service (Future Integration)
# SENDGRID_API_KEY="your-sendgrid-key"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-password"

# Analytics (Future Integration)
# GOOGLE_ANALYTICS_ID="G-XXXXXXXXXX"

# Node Environment
# NODE_ENV="development" | "production"
